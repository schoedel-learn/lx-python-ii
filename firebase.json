{
  "firestore": [
    {
      "database": "ai-studio-a6dc8729-d15a-47c8-9a5a-07d38ecc6d2f",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "target": "lx-python-ii",
    "public": "dist/app/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  }
}
